{
  "name": "main branch protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "Settings Audit"
          }
        ]
      }
    }
  ],
  "bypass_actors": [
    {
      "actor_type": "Integration",
      "actor_id": 801323,
      "bypass_mode": "always"
    }
  ]
}
